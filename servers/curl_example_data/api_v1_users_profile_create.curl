# POST /api/v1/users/profile/create
# Run from the repository root.
# curl --config ./servers/curl_example_data/api_v1_users_profile_create.curl "${base_url}/api/v1/users/profile/create"
# Set base_url to the running server origin (for example http://127.0.0.1:9090).
request = "POST"
header = "Content-Type: application/json"
data = "@./servers/curl_example_data/api_v1_users_profile_create.json"
