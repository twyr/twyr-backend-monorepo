# GET /api/v1/masterdata/system-messages/:messageCode
# Run from the repository root.
# curl --config ./servers/curl_example_data/api_v1_masterdata_system_messages_by_message_code.curl "${base_url}/api/v1/masterdata/system-messages/${messageCode}"
# Set base_url to the running server origin (for example http://127.0.0.1:9090).
# Set messageCode to an existing record identifier.
# Use cookies.txt from a successful login in the corresponding domain.
request = "GET"
header = "Content-Type: application/json"
cookie = "./cookies.txt"
