# DELETE /api/v1/system-admin/profile/delete
# Run from the repository root.
# curl --config ./servers/curl_example_data/api_v1_system_admin_profile_delete.curl "${base_url}/api/v1/system-admin/profile/delete"
# Set base_url to the running server origin (for example http://127.0.0.1:9090).
# Use cookies.txt from a successful login in the corresponding domain.
request = "DELETE"
header = "Content-Type: application/json"
cookie = "./cookies.txt"
