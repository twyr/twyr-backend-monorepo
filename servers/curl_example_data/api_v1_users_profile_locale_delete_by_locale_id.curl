# DELETE /api/v1/users/profile/locale/delete/:localeId
# Run from the repository root.
# curl --config ./servers/curl_example_data/api_v1_users_profile_locale_delete_by_locale_id.curl "${base_url}/api/v1/users/profile/locale/delete/${localeId}"
# Set base_url to the running server origin (for example http://127.0.0.1:9090).
# Set localeId to an existing record identifier.
# Use cookies.txt from a successful login in the corresponding domain.
request = "DELETE"
header = "Content-Type: application/json"
cookie = "./cookies.txt"
